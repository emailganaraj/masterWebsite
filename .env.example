# Application
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=My Article Website

# Database (PostgreSQL)
DATABASE_URL=postgresql://masterwebsite:masterwebsite_dev@localhost:5432/masterwebsite

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-minimum-secret
BETTER_AUTH_URL=http://localhost:3000

# Cache revalidation (CMS publish webhook)
REVALIDATE_SECRET=change-me-revalidate-secret

# Cloudflare R2 (Phase 2 — media uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=masterwebsite-media
R2_PUBLIC_URL=

# Google AdSense (Phase 5)
ADSENSE_PUBLISHER_ID=

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=
